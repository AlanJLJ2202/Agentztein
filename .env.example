# Copy to .env. Never commit real values.
DATABASE_URL=postgres://skillab:skillab@localhost:5432/skillab
# Required only from E2 onwards, for real-model calibration runs.
ANTHROPIC_API_KEY=
# Hosted Postgres (Supabase): PEM contents of the project's CA certificate. Leave empty for local Postgres.
DATABASE_SSL_CA=
# Sign-in and bring-your-own-key (functions in /api). Set them in Vercel → Settings → Environment Variables.
SUPABASE_URL=
# Public anon/publishable key of the Supabase project (safe in the browser; the app reads it from /api/config).
SUPABASE_ANON_KEY=
# 32+ random characters; encrypts users' API keys (AES-256-GCM). Changing it makes saved keys unreadable.
KEYS_ENCRYPTION_SECRET=
# Sound effects and the agent's voice on the landing (ElevenLabs). Optional: without a key the page synthesises its own sounds.
ELEVENLABS_API_KEY=
# Optional: the ElevenLabs voice id the agent speaks with (default: the premade voice "George").
ELEVENLABS_VOICE_ID=
# Research radar sources (see README). Optional: a fine-grained GitHub token with no permissions raises the search limit.
GITHUB_TOKEN=
# Reddit Data API app (approved by Reddit). Without both, Reddit stays off and its logo is hidden.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
