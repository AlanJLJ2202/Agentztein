{
  "name": "skillab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm datasets:verify && pnpm test && pnpm test:core && pnpm build:panel && pnpm build:app",
    "db:generate": "pnpm --filter @skillab/db generate",
    "db:migrate": "pnpm --filter @skillab/db migrate",
    "datasets:generate": "tsx packages/scenarios/src/cli/generate.ts",
    "datasets:verify": "tsx packages/scenarios/src/cli/generate.ts --verify && tsx scripts/evalset.ts --verify",
    "env:conflict": "tsx packages/env-recon/src/cli/conflict.ts",
    "datasets:review": "tsx packages/scenarios/src/cli/review.ts",
    "build:panel": "pnpm --filter @skillab/panel build",
    "build:site": "pnpm build:panel && pnpm build:app && pnpm --filter @skillab/landing build && rm -rf site && mkdir -p site/panel site/app && cp -r apps/landing/dist/. site/ && cp -r apps/panel/dist/. site/panel/ && cp -r apps/app/dist/. site/app/",
    "build:app": "pnpm --filter @skillab/app build",
    "evalset": "tsx scripts/evalset.ts",
    "auth:check": "node scripts/auth-check.mjs",
    "test:core": "node --test packages/agent-core/test/*.test.mjs",
    "evolve:bench": "tsx scripts/evolve/bench.ts",
    "evolve:gate": "tsx scripts/evolve/gate.ts",
    "evolve:workshop": "tsx scripts/evolve/workshop.ts",
    "evolve:forja": "tsx scripts/evolve/forja.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "22.20.5",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "@skillab/scenarios": "workspace:*",
    "@skillab/contracts": "workspace:*"
  },
  "dependencies": {
    "@skillab/agent-core": "workspace:*",
    "@skillab/research": "workspace:*",
    "pg": "^8.23.1"
  }
}
