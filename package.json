{
  "name": "skillab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm datasets:verify && pnpm test && pnpm build:panel",
    "db:generate": "pnpm --filter @skillab/db generate",
    "db:migrate": "pnpm --filter @skillab/db migrate",
    "datasets:generate": "tsx packages/scenarios/src/cli/generate.ts",
    "datasets:verify": "tsx packages/scenarios/src/cli/generate.ts --verify",
    "env:conflict": "tsx packages/env-recon/src/cli/conflict.ts",
    "datasets:review": "tsx packages/scenarios/src/cli/review.ts",
    "build:panel": "pnpm --filter @skillab/panel build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "22.20.5",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
