{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:site",
  "outputDirectory": "site",
  "framework": null,
  "functions": {
    "api/radar.js": {
      "maxDuration": 60
    },
    "api/keys.js": {
      "maxDuration": 30
    },
    "api/agent.js": {
      "maxDuration": 120
    },
    "api/media.js": {
      "maxDuration": 60
    },
    "api/audio.js": {
      "maxDuration": 60
    },
    "api/evolve.js": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
